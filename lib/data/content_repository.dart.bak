import '../models/scene.dart';
import '../models/game_map.dart';
import '../models/dialogue.dart';

class ContentRepository {
  static final ContentRepository _instance = ContentRepository._internal();

  factory ContentRepository() {
    return _instance;
  }

  ContentRepository._internal();

  Act getActOne() {
    final chapter1 = Chapter(
      id: 'chapter_1',
      number: '1',
      title: 'O Fim é o Começo',
      objective: 'Sobreviver à explosão e conhecer Lyra',
      scenes: _getChapter1Scenes(),
      nextChapterId: 'chapter_2',
    );

    final chapter2 = Chapter(
      id: 'chapter_2',
      number: '2',
      title: 'Pegadas Inversas',
      objective: 'Investigar o passado de seu pai',
      scenes: _getChapter2Scenes(),
      nextChapterId: 'chapter_3',
    );

    final chapter3 = Chapter(
      id: 'chapter_3',
      number: '3',
      title: 'O Eclipse de 2031',
      objective: 'Encontrar Lyra novamente',
      scenes: _getChapter3Scenes(),
      nextChapterId: null,
    );

    return Act(
      id: 'act_1',
      number: '1',
      title: 'O Efeito Causal',
      chapters: [chapter1, chapter2, chapter3],
    );
  }

  List<Scene> _getChapter1Scenes() {
    return [
      Scene(
        id: 'scene_1_1',
        name: 'Quarto de Kael',
        description: 'Manhã normal. Despertador toca.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_relógio',
            label: 'Relógio',
            description: 'Um relógio digital comum, marcando 07:30.',
            position: Offset(0.44, 0.1),
            radius: 40,
          ),
          Hotspot(
            id: 'hotspot_janela',
            label: 'Janela',
            description: 'Janelas com vista para o pátio de Aethelgard ao longe.',
            position: Offset(0.16, 0.3),
            radius: 60,
          ),
          Hotspot(
            id: 'hotspot_sair_quarto',
            label: 'Sair',
            description: 'Sair do quarto.',
            position: Offset(0.9, 0.4),
            radius: 50,
          ),
          Hotspot(
            id: 'hotspot_cama',
            label: 'Cama',
            description: 'Uma cama simples, com lençóis limpos.',
            position: Offset(0.65, 0.75),
            radius: 50,
          ),
        ],
        nextSceneId: 'scene_1_2',
      ),
      Scene(
        id: 'scene_1_2',
        name: 'Rua para a escola',
        description: 'Caminho até Aethelgard. Tudo silencioso.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_som_distante',
            label: 'Som distante',
            description: 'Um rugido baixo vindo de Aethelgard. Incomum.',
            position: Offset(0.5, 0.4),
            radius: 50,
          ),
          Hotspot(
            id: 'hotspot_beco',
            label: 'Beco lateral',
            description: 'Um atalho que poderia ser mais rápido.',
            position: Offset(0.15, 0.6),
            radius: 40,
          ),
        ],
        nextSceneId: 'scene_1_3',
      ),
      Scene(
        id: 'scene_1_3',
        name: 'Ruínas de Aethelgard',
        description: 'O instituto está destruído. Fumaça por toda parte.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_metal_fragmento',
            label: 'Fragmento metálico',
            description: 'Um pedaço de metal deformado, ainda quente.',
            position: Offset(0.3, 0.5),
            radius: 35,
          ),
          Hotspot(
            id: 'hotspot_luz_pulsante',
            label: 'Luz pulsante',
            description: 'Uma luz azul que pisca ritmicamente nas profundezas.',
            position: Offset(0.7, 0.3),
            radius: 50,
          ),
        ],
        nextSceneId: 'scene_1_4',
      ),
      Scene(
        id: 'scene_1_4',
        name: 'Encontro com Lyra',
        description: 'Uma mulher de 35 anos, caída entre os escombros.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_lyra',
            label: 'Lyra',
            description: 'Uma mulher com olhos azuis elétricos, sangrando levemente.',
            position: Offset(0.5, 0.6),
            radius: 80,
          ),
          Hotspot(
            id: 'hotspot_relogio_quebrado',
            label: 'Relógio quebrado',
            description: 'Um relógio de bolso com os ponteiros girando para trás.',
            position: Offset(0.45, 0.65),
            radius: 30,
          ),
        ],
        nextSceneId: null,
      ),
    ];
  }

  List<Scene> _getChapter2Scenes() {
    return [
      Scene(
        id: 'scene_2_1',
        name: 'Escola - Sala de aula',
        description: 'Três anos depois. A vida continua normal, mas Kael observa.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_professor',
            label: 'Professor',
            description: 'Um professor entediado, aula de matemática.',
            position: Offset(0.5, 0.2),
            radius: 50,
          ),
          Hotspot(
            id: 'hotspot_jude',
            label: 'Jude',
            description: 'Seu melhor amigo. Está dormindo.',
            position: Offset(0.7, 0.5),
            radius: 40,
          ),
        ],
        nextSceneId: 'scene_2_2',
      ),
      Scene(
        id: 'scene_2_2',
        name: 'Biblioteca',
        description: 'Kael pesquisa sobre Lyra em arquivos públicos.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_computador',
            label: 'Computador',
            description: 'Terminal público com acesso aos arquivos municipais.',
            position: Offset(0.5, 0.5),
            radius: 60,
          ),
          Hotspot(
            id: 'hotspot_jornais',
            label: 'Jornais antigos',
            description: 'Reportagens sobre a "Catástrofe de Aethelgard".',
            position: Offset(0.2, 0.4),
            radius: 50,
          ),
        ],
        nextSceneId: 'scene_2_3',
      ),
      Scene(
        id: 'scene_2_3',
        name: 'Quarto de Kael - Noite',
        description: 'Mural de pistas começando a se formar.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_mural',
            label: 'Mural de pistas',
            description: 'Fotos, recortes e notas presas na parede.',
            position: Offset(0.5, 0.4),
            radius: 100,
          ),
          Hotspot(
            id: 'hotspot_relogio_investigacao',
            label: 'Relógio de Lyra',
            description: 'O relógio sobre a mesa, os ponteiros ainda giram ao contrário.',
            position: Offset(0.8, 0.3),
            radius: 35,
          ),
        ],
        nextSceneId: null,
      ),
    ];
  }

  List<Scene> _getChapter3Scenes() {
    return [
      Scene(
        id: 'scene_3_1',
        name: 'Observatório - Externa',
        description: 'Um lugar isolado. Época de encontro. Kael espera.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_céu_noturno',
            label: 'Céu noturno',
            description: 'Estrelas e uma anomalia luminosa pulsante.',
            position: Offset(0.5, 0.2),
            radius: 80,
          ),
          Hotspot(
            id: 'hotspot_entrada_obs',
            label: 'Entrada do Observatório',
            description: 'Porta antiga com ferrugem.',
            position: Offset(0.1, 0.7),
            radius: 50,
          ),
        ],
        nextSceneId: 'scene_3_2',
      ),
      Scene(
        id: 'scene_3_2',
        name: 'Interior do Observatório',
        description: 'Telescópio quebrado, mesas de trabalho abandonadas.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_telescopio',
            label: 'Telescópio quebrado',
            description: 'Uma máquina antiga, espelho rachado.',
