  DialogueTree getDialogueTree(String treeId) {
    switch (treeId) {
      case 'chapter_1_lyra_initial':
        return _getChapter1LyraDialogue();
      case 'chapter_3_lyra_eclipse':
        return _getChapter3LyraDialogue();
      default:
        return _getDefaultDialogue();
    }
  }

  DialogueTree _getChapter1LyraDialogue() {
    final nodes = {
      'node_1': DialogueNode(
        id: 'node_1',
        character: 'Lyra',
        text: 'Você... você sobreviveu.',
        options: [
          DialogueOption(
            id: 'option_1_1',
            text: 'Quem é você?',
            nextDialogueId: 'node_2',
          ),
          DialogueOption(
            id: 'option_1_2',
            text: 'O que aconteceu aqui?',
            nextDialogueId: 'node_3',
          ),
        ],
      ),
      'node_2': DialogueNode(
        id: 'node_2',
        character: 'Lyra',
        text: 'Não confie no jaleco branco. Promete?',
        options: [
          DialogueOption(
            id: 'option_2_1',
            text: 'Prometo.',
            nextDialogueId: 'node_4',
            statChanges: {'lyraConfianca': 5.0},
          ),
          DialogueOption(
            id: 'option_2_2',
            text: 'Do que você está falando?',
            nextDialogueId: 'node_5',
          ),
        ],
      ),
      'node_3': DialogueNode(
        id: 'node_3',
        character: 'Lyra',
        text: 'Tempo. O tempo quebrou.',
        options: [
          DialogueOption(
            id: 'option_3_1',
            text: 'Como isso é possível?',
            nextDialogueId: 'node_6',
          ),
          DialogueOption(
            id: 'option_3_2',
            text: 'Você está machucada. Deixe-me ajudar.',
            nextDialogueId: 'node_2',
            statChanges: {'lyraConfianca': 10.0},
          ),
        ],
      ),
      'node_4': DialogueNode(
        id: 'node_4',
        character: 'Lyra',
        text: 'Eu amo você. Você precisa ser forte.',
        options: [
          DialogueOption(
            id: 'option_4_1',
            text: 'Espere! Não vá!',
            nextDialogueId: 'node_7',
            statChanges: {'ruptura': 5.0},
          ),
        ],
        itemReceived: 'relógio_quebrado',
        isEnd: true,
      ),
      'node_5': DialogueNode(
        id: 'node_5',
        character: 'Lyra',
        text: 'Seu pai... ele não é quem você pensa.',
        options: [
          DialogueOption(
            id: 'option_5_1',
            text: 'Meu pai?',
            nextDialogueId: 'node_4',
          ),
        ],
        clueDiscovered: 'pai_suspeito',
      ),
      'node_6': DialogueNode(
        id: 'node_6',
        character: 'Lyra',
        text: 'Não há tempo para explicar. Você vai entender mais tarde.',
        options: [
          DialogueOption(
            id: 'option_6_1',
            text: 'Deixe-me tentar.',
            nextDialogueId: 'node_4',
            statChanges: {'sincronia': 5.0},
          ),
        ],
      ),
      'node_7': DialogueNode(
        id: 'node_7',
        character: 'Narrador',
        text: 'Ela desaparece na luz azul, deixando apenas o relógio em sua mão tremendo.',
        options: [],
        isEnd: true,
      ),
    };

    return DialogueTree(
      id: 'chapter_1_lyra_initial',
      npcName: 'Lyra',
      nodes: nodes,
      rootNodeId: 'node_1',
    );
  }

  DialogueTree _getChapter3LyraDialogue() {
    final nodes = {
      'node_1': DialogueNode(
        id: 'node_1',
        character: 'Lyra',
        text: 'Você está confuso. Eu também estava, a primeira vez.',
        options: [
          DialogueOption(
            id: 'option_1_1',
            text: 'Você se lembra de mim?',
            nextDialogueId: 'node_2',
          ),
          DialogueOption(
            id: 'option_1_2',
            text: 'Como você sabe meu nome?',
            nextDialogueId: 'node_3',
          ),
        ],
      ),
      'node_2': DialogueNode(
        id: 'node_2',
        character: 'Lyra',
        text: 'Sim. Você é jovem demais ainda. Ainda não sofreu o suficiente.',
        options: [
          DialogueOption(
            id: 'option_2_1',
            text: 'O que você quer dizer?',
            nextDialogueId: 'node_4',
            statChanges: {'sincronia': 8.0},
          ),
        ],
      ),
      'node_3': DialogueNode(
        id: 'node_3',
        character: 'Lyra',
        text: 'O diário. Você vai me dar um diário, cinco anos a partir de agora.',
        options: [
          DialogueOption(
            id: 'option_3_1',
            text: 'Você está doente?',
            nextDialogueId: 'node_2',
          ),
        ],
        clueDiscovered: 'diario_paradoxo',
      ),
      'node_4': DialogueNode(
        id: 'node_4',
        character: 'Lyra',
        text: 'Há uma conspiração. Seu pai está vivo. Ele quer nos usar.',
        options: [
          DialogueOption(
            id: 'option_4_1',
            text: 'Meu pai morreu em 2026.',
            nextDialogueId: 'node_5',
          ),
          DialogueOption(
            id: 'option_4_2',
            text: 'Como você sabe isso?',
            nextDialogueId: 'node_6',
            statChanges: {'lyraConfianca': 12.0},
          ),
        ],
      ),
      'node_5': DialogueNode(
        id: 'node_5',
        character: 'Lyra',
        text: 'Ele não morreu. Ele foi para um lugar que não existe.',
        options: [
          DialogueOption(
            id: 'option_5_1',
            text: 'Você está falando em ridículos.',
            nextDialogueId: 'node_6',
            statChanges: {'lyraConfianca': -5.0},
          ),
        ],
      ),
      'node_6': DialogueNode(
        id: 'node_6',
        character: 'Lyra',
        text: 'Você vai me entender. Quando chegar a hora.',
        options: [
          DialogueOption(
            id: 'option_6_1',
            text: 'Promete que vai me contar tudo?',
            nextDialogueId: 'node_7',
            statChanges: {'lyraConfianca': 15.0},
          ),
        ],
      ),
      'node_7': DialogueNode(
        id: 'node_7',
        character: 'Lyra',
        text: 'Eu prometo. Mas primeiro, você precisa ser corajoso.',
        options: [],
        isEnd: true,
      ),
    };

    return DialogueTree(
      id: 'chapter_3_lyra_eclipse',
      npcName: 'Lyra',
      nodes: nodes,
      rootNodeId: 'node_1',
    );
  }

  DialogueTree _getDefaultDialogue() {
    final nodes = {
      'node_default': DialogueNode(
        id: 'node_default',
        character: 'Unknown',
        text: 'Olá.',
        options: [],
        isEnd: true,
      ),
    };

    return DialogueTree(
      id: 'default',
      npcName: 'Unknown',
      nodes: nodes,
      rootNodeId: 'node_default',
    );
  }
}
