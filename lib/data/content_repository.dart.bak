          ),
        ],
        nextSceneId: 'scene_3_3',
      ),
      Scene(
        id: 'scene_3_3',
        name: 'Ponto de Sincronia',
        description: 'Lyra aparece. Agora ela tem 30 anos. Kael tem 20.',
        backgroundImage: 'assets/bedroom.png',
        hotspots: [
          Hotspot(
            id: 'hotspot_lyra_2031',
            label: 'Lyra (30 anos)',
            description: 'Mais madura que antes, mas ainda melancólica.',
            position: Offset(0.5, 0.5),
            radius: 90,
          ),
          Hotspot(
            id: 'hotspot_relatorio',
            label: 'Antigo relatório',
